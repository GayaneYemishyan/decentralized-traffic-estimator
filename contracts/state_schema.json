{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "State (P2 inference -> P3/P4)",
  "type": "object",
  "required": ["node_id", "cell_id", "timestamp", "state", "congestion_pct", "confidence"],
  "properties": {
    "node_id": {"type": "string"},
    "cell_id": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "state": {"type": "string", "enum": ["free", "moderate", "congested"]},
    "congestion_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
